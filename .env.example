# Copy to .env for local development. Production values come from the
# family-hub Ansible role in ~/dev/dotfiles (secrets via SOPS).

# ── Telegram bot ─────────────────────────────────────────────────────────────
# Token from @BotFather. Use a separate dev bot: one token = one webhook /
# polling consumer, prod and dev cannot share.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids allowed to talk to the bot. Empty = allow everyone
# (fine locally, never in prod). Send /start and read the logged chat id.
TELEGRAM_ALLOWED_CHATS=
# Chat id reminders and digests are pushed to (the family group). Empty
# disables the lesson reminder scheduler — that is why local runs stay quiet.
TELEGRAM_NOTIFY_CHAT=
# Optional: webhook instead of long polling. Leave empty locally. In webhook
# mode the secret is mandatory (the app refuses to start without it).
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Minutes after a lesson slot to ask "было?" (default 60; <0 disables).
TELEGRAM_REMINDER_DELAY_MIN=
# Minutes before a slot to warn about an empty balance (default 120; <0 off).
TELEGRAM_PRELESSON_LEAD_MIN=

# ── Gemini (free-text appointment capture) ───────────────────────────────────
# Without a key the bot still serves lessons, /week, /list and field edits —
# only free-text capture and datetime re-parsing switch off.
GEMINI_API_KEY=
# gemini-flash-lite-latest works on this account; exact-versioned ids 403'd.
GEMINI_MODEL=gemini-flash-lite-latest
# Optional roster to normalize the "who" field (comma-separated). Empty =
# keep the person as written in the message.
VISIT_PEOPLE=

# ── Appointment digests ──────────────────────────────────────────────────────
# Master switch for the daily/weekly appointment digests. Default false: Home
# Assistant owns those summaries in prod (its Remote Calendar reads the ICS
# feed below), so turning this on would double-post to the group. Lesson
# reminders are a separate ticker and are unaffected. Truthy: 1/true/yes/on.
NOTIFICATIONS_ENABLED=false
# Morning "today" digest time (HH:MM, local). Empty disables it.
DAILY_DIGEST_TIME=08:00
# Weekly "this week" digest: day-of-week (0=Sun..6=Sat) + time. Empty DOW off.
WEEKLY_DIGEST_DOW=0
WEEKLY_DIGEST_TIME=18:00

# ── App ──────────────────────────────────────────────────────────────────────
# Timezone for stored wall-clock times ("HH:MM" slots, appointment starts) and
# for resolving "завтра / в четвер". Read by Go as time.Local; the container
# sets it from the role.
TZ=Europe/Kyiv
# Optional shared secret for the ICS feed (GET /calendar.ics?token=...). Empty
# = the feed is open. Set it and put ?token=... in HA's Remote Calendar URL.
ICS_TOKEN=
